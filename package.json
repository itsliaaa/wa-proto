{
  "name": "@itsliaaa/wa-proto",
  "version": "2.3000.1046504820",
  "description": "Protobuf files from WhatsApp WEB",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsliaaa/wa-proto.git"
  },
  "author": {
    "name": "Cleiton Costa",
    "url": "https://github.com/icleitoncosta"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "npm run fetch && npm run compile",
    "compile": "npm run compile:js && npm run compile:ts",
    "compile:js": "node scripts/patch-protobufjs-parser.js && pbjs -t static-module --no-beautify -w es6 --no-bundle --no-delimited --no-verify --no-comments --no-service --no-typeurl -o ./dist/index.js ./WAProto.proto && node scripts/fix-imports.js",
    "compile:ts": "pbjs -t static-module --no-beautify -w es6 --no-bundle --no-delimited --no-verify --no-service --no-typeurl ./WAProto.proto | pbts --no-comments -o ./index.d.ts -",
    "fetch": "node index.js"
  },
  "dependencies": {
    "long": "^5.3.2",
    "protobufjs": "^7.6.6",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "protobufjs-cli": "^1.3.3",
    "puppeteer-real-browser": "^1.4.4"
  }
}
