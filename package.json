{
  "name": "@itsliaaa/wa-proto",
  "version": "2.3000.1048152143",
  "description": "Protobuf files from WhatsApp WEB",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsliaaa/wa-proto.git"
  },
  "author": {
    "name": "Cleiton Costa",
    "url": "https://github.com/icleitoncosta"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "npm run fetch && npm run compile",
    "compile": "npm run compile:generate && npm run compile:ts && npm run compile:js",
    "compile:generate": "node scripts/patch-protobufjs-parser.js && pbjs -t static-module --no-beautify -w es6 --no-bundle --no-delimited --no-verify --no-comments --no-service --no-typeurl -o ./dist/index.generated.js ./WAProto.proto",
    "compile:ts": "pbts --no-comments -o ./dist/index.d.ts ./dist/index.generated.js",
    "compile:js": "cp ./dist/index.generated.js ./dist/index.js && node scripts/fix-imports.js && node scripts/minify.js && rm ./dist/index.generated.js",
    "fetch": "node index.js"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.28.2",
    "long": "^5.3.2",
    "protobufjs": "^7.6.6",
    "protobufjs-cli": "^1.3.3",
    "puppeteer-real-browser": "^1.4.4",
    "terser": "^5.50.0"
  },
  "allowScripts": {
    "esbuild": true,
    "protobufjs": true
  }
}
